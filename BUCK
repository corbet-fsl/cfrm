# Hand-written Buck2 targets for cfrm (third-party crates come from //third-party, generated by reindeer).
LIB_DEPS = [
    "//third-party:axum",
    "//third-party:schemars",
    "//third-party:serde",
    "//third-party:serde_json",
    "//third-party:tokio",
    "//third-party:ts-rs",
    "//third-party:url",
]
DEV_DEPS = [
    "//third-party:tower",
    "//third-party:http-body-util",
    "//third-party:futures-util",
    "//third-party:rmcp",
]

rust_library(
    name = "cfrm",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    features = ["server"],
    deps = LIB_DEPS,
    visibility = ["PUBLIC"],
)

# Unit tests inside the library crate (cargo test --lib).
rust_test(
    name = "cfrm-unit",
    srcs = glob(["src/**/*.rs"]),
    crate = "cfrm",
    crate_root = "src/lib.rs",
    edition = "2024",
    features = ["server"],
    deps = LIB_DEPS + DEV_DEPS,
)

rust_test(
    name = "mcp_projection",
    srcs = ["tests/mcp_projection.rs"],
    crate_root = "tests/mcp_projection.rs",
    edition = "2024",
    deps = [":cfrm", "//third-party:rmcp", "//third-party:serde_json"],
)

rust_binary(
    name = "export",
    srcs = ["examples/export.rs"],
    crate_root = "examples/export.rs",
    edition = "2024",
    deps = [":cfrm", "//third-party:serde_json"],
)
